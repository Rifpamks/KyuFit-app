// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int          @id @default(autoincrement())
  name                String?
  email               String?      @unique
  passwordHash        String?      @map("password_hash")
  whatsappNumber      String       @unique @map("whatsapp_number")
  age                 Int?
  gender              String?
  heightCm            Float?       @map("height_cm")
  currentWeightKg     Float?       @map("current_weight_kg")
  activityLevel       String?      @map("activity_level")
  dailyCalorieTarget  Int          @default(1779) @map("daily_calorie_target")
  targetProteinG      Int          @default(98) @map("target_protein_g")
  targetCarbsG        Int          @default(237) @map("target_carbs_g")
  targetFatsG         Int          @default(49) @map("target_fats_g")
  fitnessGoal         String       @default("maintain") @map("fitness_goal")
  bodyFatPercent       Float?       @map("body_fat_percent")
  skeletalMuscleMassKg Float?       @map("skeletal_muscle_mass_kg")
  visceralFatLevel     Int?         @map("visceral_fat_level")
  inbodyScore          Int?         @map("inbody_score")
  targetWeightKg      Float?       @map("target_weight_kg")
  dietaryRestrictions String?      @map("dietary_restrictions")
  birthDate           DateTime?    @map("birth_date")
  onboardingComplete  Boolean      @default(false) @map("onboarding_complete")
  createdAt           DateTime     @default(now()) @map("created_at")
  mealLogs            MealLog[]
  weightLogs          WeightLog[]
  workoutLogs         WorkoutLog[]
  assessmentLogs      AssessmentLog[]

  @@map("users")
}

model MealLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  timestamp  DateTime @default(now())
  foodName   String   @map("food_name")
  calories   Int
  proteinG   Int      @map("protein_g")
  carbsG     Int      @map("carbs_g")
  fatsG      Int      @map("fats_g")
  imageUrl   String?  @map("image_url")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meal_logs")
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  timestamp DateTime @default(now())
  weightKg  Float    @map("weight_kg")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weight_logs")
}

model WorkoutLog {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  timestamp       DateTime @default(now())
  activityName    String   @map("activity_name")
  durationMinutes Int      @map("duration_minutes")
  caloriesBurned  Float    @map("calories_burned")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workout_logs")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model AssessmentLog {
  id                    Int      @id @default(autoincrement())
  userId                Int      @map("user_id")
  timestamp             DateTime @default(now())
  title                 String   @default("Update Assessment")
  fitnessGoal           String   @map("fitness_goal")
  activityLevel         String   @map("activity_level")
  weightKg              Float    @map("weight_kg")
  targetWeightKg        Float?   @map("target_weight_kg")
  bodyFatPercent        Float?   @map("body_fat_percent")
  dailyCalorieTarget    Int      @map("daily_calorie_target")
  targetProteinG        Int      @map("target_protein_g")
  targetCarbsG          Int      @map("target_carbs_g")
  targetFatsG           Int      @map("target_fats_g")
  programDurationMonths Int?     @default(3) @map("program_duration_months")
  pace                  String?  @default("Moderate")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assessment_logs")
}

